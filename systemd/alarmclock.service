[Unit]
Description=AlarmClock - Wecker-Hauptprogramm (LCD, Audio, WLED, Eingaben)
After=network-online.target sound.target
Wants=network-online.target
# Nie endgueltig aufgeben (z. B. I2C kurz weg beim Booten).
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/AlarmClock
ExecStart=/home/pi/AlarmClock/.venv/bin/python alarm_clock.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
